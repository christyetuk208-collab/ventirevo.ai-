# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# OPENAI_API_KEY: Optional secondary AI provider fallback.
OPENAI_API_KEY=

# DATABASE_URL: PostgreSQL or durable cloud database connection string (optional)
DATABASE_URL=

# AUTH_SECRET: Cryptographic secret key for signing session tokens
AUTH_SECRET=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Payment & Subscription Configuration (Stripe / Paystack / Flutterwave)
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

